{
  "bar": {
    "centerAnchor": "fede.workspaces",
    "layout": {
      "center": [
        {
          "id": "fede.workspaces"
        }
      ],
      "left": [
        {
          "exec": "~/.config/omarchy/bar/ram_usage.bash",
          "fontSize": 11,
          "id": "ram",
          "interval": 30,
          "type": "command"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "fede.audio"
        },
        {
          "id": "fede.monitor"
        }
      ],
      "right": [
        {
          "id": "omarchy.indicators",
          "items": [
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "fede.clock",
          "format": "dddd HH:mm",
          "hiddenCalendars": [],
          "weekStartDay": "monday"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "cloneSourceRestores": [
    "fede.menu",
    "fede.lock"
  ],
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.lock"
  ],
  "idle": {
    "lock": 300
  },
  "plugins": [
    {
      "id": "fede.audio"
    },
    {
      "id": "fede.menu"
    },
    {
      "id": "fede.lock"
    }
  ],
  "version": 1
}
