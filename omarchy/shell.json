{
  "version": 1,
  "idle": {
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "fede.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "fede.clock",
          "format": "dddd HH:mm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "ram",
          "type": "command",
          "exec": "~/.config/omarchy/bar/ram_usage.bash",
          "interval": 30,
          "fontSize": 11
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.weather"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "fede.menu"
    },
    {
      "id": "fede.lock"
    }
  ],
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.clock",
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "fede.menu",
    "fede.clock",
    "fede.lock"
  ]
}
