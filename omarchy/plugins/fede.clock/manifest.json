{
  "schemaVersion": 1,
  "id": "fede.clock",
  "name": "My Clock",
  "version": "0.2.1",
  "author": "tmn73",
  "license": "MIT",
  "description": "Your Google Calendar in the bar. Your next meeting at a glance, and one click to join it.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "My Clock",
    "description": "Your Google Calendar in the bar. Your next meeting at a glance, and one click to join it.",
    "category": "Time",
    "allowMultiple": false,
    "defaults": {
      "format": "dddd HH:mm",
      "formatAlt": "",
      "verticalFormat": "HH\n-\nmm"
    },
    "schema": [
      {
        "key": "format",
        "type": "string",
        "label": "Date format",
        "defaultValue": "dddd HH:mm"
      },
      {
        "key": "formatAlt",
        "type": "string",
        "label": "Alternate format",
        "defaultValue": ""
      },
      {
        "key": "verticalFormat",
        "type": "string",
        "label": "Vertical bar format",
        "defaultValue": "HH\n-\nmm"
      },
      {
        "key": "birthYear",
        "type": "number",
        "label": "Birth year",
        "defaultValue": 0
      },
      {
        "key": "lifeExpectancy",
        "type": "number",
        "label": "Life expectancy",
        "defaultValue": 0
      }
    ]
  },
  "omarchy": {
    "forkedFrom": "tmn73.calendar (https://github.com/tmn73/omarchy-calendar)"
  }
}
