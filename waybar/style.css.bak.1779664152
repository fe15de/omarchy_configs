*{
    font-family: 'JetBrainsMono Nerd Font';
    font-size: 13px;
    min-height: 0;
    color: white;
}

window#waybar {
    background-color: transparent;
}

#workspaces{
    margin-top: 3px;
    margin-bottom: 2px;
    margin-right: 10px;
    margin-left: 25px;
}

#workspaces button{
    margin-right: 2px;
    padding: 1px 1px;
    font-weight: bolder;
    /* background-color: #181818; */
}

#workspaces button.active, #workspaces button.focused{
    padding: 0 8px;
    box-shadow: rgba(6, 24, 44, 0.4) 0px 0px 0px 2px, 
                rgba(6, 24, 44, 0.65) 0px 2px 2px -1px,
                rgba(255, 255, 255, 0.08) 0px 1px 0px inset;    
    background: #523ccb;
}

#tray,
#custom-brightness:hover,
#mpd,
#custom-weather,
#cpu, 
#temperature, 
#memory,
#sway-mode,
#backlight, 
#pulseaudio, 
#custom-vpn,
#disk,
#custom-recorder,
#custom-audiorec,
#battery, 
#clock, 
#idle_inhibitor,
#network {
	padding: 0 10px;
}
